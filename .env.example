# Copy to .env.local and fill in. Both values are in your Supabase project:
# Project Settings -> API (Project URL and the "anon" / publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never put the service_role key in this app: it is not used, and
# NEXT_PUBLIC_ variables are shipped to the browser.
